# Virtual environment
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and package outputs
build/
dist/
*.egg-info/

# Environment variables and secrets
.env
.env.*
!.env.example

# Editor-specific files
.vscode/

# Raw and generated project data
data/raw/*
!data/raw/sample.log
data/processed/*

# Keep the empty data directories in Git
!data/raw/.gitkeep
!data/processed/.gitkeep